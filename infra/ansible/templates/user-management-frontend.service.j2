# Managed by Ansible
[Unit]
Description=User Management frontend (Angular ng serve)
After=network-online.target
Wants=network-online.target

[Service]
User={{ app_user }}
WorkingDirectory={{ app_dir }}
Environment=NG_CLI_ANALYTICS=false
Environment=CI=true
ExecStart=/usr/bin/npx ng serve --host 0.0.0.0 --port 4200
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
